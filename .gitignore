!.env.example

# Editor, OS, and local agent state
.DS_Store
.idea/
.vscode/
*.swp
.agents/
.codex/

# Datasets, caches, checkpoints, and generated artifacts
.cache/
real_data/
scratch/
outputs/
runs/
storage/
